{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feeling Fabric participant contribution v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "wordIds",
    "composition",
    "svg",
    "preview",
    "createdAt",
    "origin",
    "storage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "wordIds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50
      }
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "note": {
      "type": "string",
      "maxLength": 800
    },
    "composition": {
      "type": "object",
      "required": [
        "version",
        "layers",
        "baseShape",
        "strokes"
      ],
      "properties": {
        "version": {
          "const": 3
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8
        },
        "baseShape": {
          "enum": [
            "square",
            "rounded",
            "circle",
            "irregular"
          ]
        },
        "strokes": {
          "type": "array"
        }
      }
    },
    "svg": {
      "type": "string"
    },
    "preview": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "const": "participant"
    },
    "storage": {
      "const": "browser-local"
    }
  }
}